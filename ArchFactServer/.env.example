APP_NAME=ArchFact API
APP_ENV=development
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173"]

MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=archfact
GRIDFS_BUCKET=pdf_files
FILE_STORAGE_ROOT=.runtime/files

# local 只做分页文本提取，coze 执行结构化语义抽取。
EXTRACTION_ENGINE=local
COZE_API_BASE=https://api.coze.cn
COZE_API_TOKEN=
COZE_WORKFLOW_ID=
COZE_HTTP_URL=
COZE_HTTP_TOKEN=
COZE_HTTP_TIMEOUT_SECONDS=180

# Generic structured extraction through DeepSeek's OpenAI-compatible endpoint.
LLM_PROVIDER=deepseek
LLM_API_BASE=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash
LLM_TIMEOUT_SECONDS=180
LLM_MAX_RETRIES=2
LLM_MAX_CONCURRENCY=3
SEMANTIC_PAGE_CONCURRENCY=3
LLM_MAX_TOKENS=4096
LLM_INPUT_CHUNK_CHARS=1600
LLM_CHUNK_OVERLAP_CHARS=160
LLM_REQUEST_TOKEN_BUDGET=10000
LLM_MAX_RECORDS_PER_CHUNK=10
LLM_THINKING=false
SEMANTIC_CANDIDATE_FILTER_ENABLED=true
SEMANTIC_CACHE_ENABLED=true

# 人工核验后的异步 AI 复核。默认复用上面的 API 地址和 Key，模型可单独覆盖。
VERIFICATION_LLM_MODEL=
VERIFICATION_LLM_TIMEOUT_SECONDS=120
VERIFICATION_LLM_MAX_CONCURRENCY=3
VERIFICATION_LLM_MAX_TOKENS=1800

# 人工标注数据仅用于质量评测；图片仍保存在本地，MongoDB 只保存相对 object_key。
GOLD_DATASET_ROOT=../参考资料/人工标注/文家山

# PDF 页面预处理：按批次渲染选中页，分页图片写入 FILE_STORAGE_ROOT。
PAGE_RENDER_SCALE=1.5
PAGE_PREPARATION_BATCH_SIZE=8

# 整本 PDF 轻量发现：低分辨率扫描全部页，只对候选页做低清 OCR。
DISCOVERY_ENABLED=true
DISCOVERY_THUMBNAIL_SCALE=0.30
DISCOVERY_OCR_RENDER_SCALE=0.75
DISCOVERY_TEXT_PREVIEW_CHARS=1200
DISCOVERY_COLOR_RATIO_THRESHOLD=0.035
DISCOVERY_OCR_CONCURRENCY=2
# 0 表示不限制；建议先保留 80，结合实际报告召回率调整。
DISCOVERY_OCR_MAX_PAGES=80
DISCOVERY_MAX_RECALLED_PAGES=24

# 扫描页 OCR。可选 disabled、tesseract、paddle。
# paddle 使用独立 Python 环境启动本地长驻 PaddleOCR 工作进程。
OCR_ADAPTER=disabled
OCR_POLICY=all
TESSERACT_COMMAND=tesseract
OCR_LANGUAGES=chi_sim+eng
OCR_PAGE_SEGMENTATION_MODE=3
OCR_MIN_CONFIDENCE=0.15
PADDLE_OCR_PYTHON=
PADDLE_OCR_WORKER_PATH=app/services/paddle_ocr_worker.py
PADDLE_OCR_LANGUAGE=ch
PADDLE_OCR_USE_ANGLE_CLS=false
PADDLE_OCR_TIMEOUT_SECONDS=180
PADDLE_OCR_WORKERS=2
PADDLE_OCR_WORKER_THREADS=6
REGION_OCR_MIN_CONFIDENCE=0.50
REGION_CROP_PADDING=0.01

# disabled 为默认值；json 用于在接入真实 YOLO 前验证检测数据链路。
YOLO_ADAPTER=disabled
YOLO_PREDICTIONS_PATH=
YOLO_MODEL_PATH=models/archaeology-yolo/v1/best.pt
YOLO_CONFIG_PATH=models/archaeology-yolo/v1/model.yaml
YOLO_DEVICE=0
YOLO_CONFIDENCE=0.30
YOLO_IOU=0.50
YOLO_IMAGE_SIZE=640
YOLO_MODEL_NAME=archaeology-yolo
YOLO_MODEL_VERSION=v1
YOLO_CLASS_MAPPING={"qiwu":"artifact","xuhao":"number","tuzhu":"caption","muzang":"grave_drawing","zhengti":"group"}

# 全局区域关系匹配参数（布局、距离、重叠和置信度的权重）。
RELATION_MATCHING_MIN_SCORE=0.42
RELATION_MATCHING_MAX_DISTANCE=0.5
RELATION_GROUP_CONTAINMENT_THRESHOLD=0.5
RELATION_LAYOUT_WEIGHT=0.35
RELATION_DISTANCE_WEIGHT=0.30
RELATION_OVERLAP_WEIGHT=0.20
RELATION_CONFIDENCE_WEIGHT=0.15

MAX_UPLOAD_BYTES=104857600
MAX_PDF_PAGES=1000
JOB_EVENT_LIMIT=50
